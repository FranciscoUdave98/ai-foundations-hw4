# Copy this file to .env and fill in your own values. Never commit .env.
# Portkey key used for every AI call (the app also accepts PORTKEY_API_KEY).
PORTKEY_PAI_KEY=your-portkey-key-here
# PORTKEY_API_KEY=your-portkey-key-here

# Optional: only for generating AI on-model photos with the imagegen CLI.
# OPENAI_API_KEY=your-openai-key-here
